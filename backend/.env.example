PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agroroute
# En Neon (producción) SIEMPRE debe ir en true
DATABASE_SSL=false
DEFAULT_USER_ID=a0000000-0000-0000-0000-000000000001
DEFAULT_USER_ROLE=producer

# --- Variables adicionales requeridas en PRODUCCIÓN (Render) ---
# URL pública del frontend en Vercel, separadas por coma si hay más de una
# (dominio de Vercel + dominio propio si lo hubiera). Sin barra final.
# Ejemplo: CORS_ORIGIN=https://agroroute.vercel.app,https://www.tu-dominio.com
CORS_ORIGIN=*

# Límite de solicitudes por IP por minuto hacia la API (protege OSRM/Open-Meteo/Neon)
RATE_LIMIT_MAX=60
